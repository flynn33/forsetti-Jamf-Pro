{
  "schemaVersion": "1.1",
  "manifestTemplateVersion": "1.1",
  "moduleID": "com.forsetti.jamfpro.retail.ui",
  "displayName": "Forsetti Retail UI",
  "moduleVersion": {
    "major": 3,
    "minor": 32,
    "patch": 1,
    "prerelease": null
  },
  "moduleType": "ui",
  "supportedPlatforms": [
    "iOS",
    "macOS"
  ],
  "minForsettiVersion": {
    "major": 0,
    "minor": 1,
    "patch": 4,
    "prerelease": null
  },
  "maxForsettiVersion": null,
  "capabilitiesRequested": [
    "routing_overlay",
    "ui_theme_mask",
    "toolbar_items",
    "view_injection",
    "file_export",
    "telemetry"
  ],
  "iapProductID": null,
  "entryPoint": "ForsettiRetailUIModule",
  "defaultModuleRole": "ui",
  "runtimeRequirements": {
    "io": [
      {
        "requirementID": "ui-file-export",
        "kind": "file_export",
        "access": "write",
        "required": true,
        "description": "User-initiated native export/share presentation."
      },
      {
        "requirementID": "ui-telemetry",
        "kind": "telemetry",
        "access": "emit",
        "required": false,
        "description": "Optional UI interaction telemetry."
      }
    ],
    "ui": {
      "controlSchemeID": "forsetti-retail-command-center",
      "layoutID": "dashboard-responsive-shell",
      "themeIDs": [
        "obsidian-data-stream",
        "dashboard-dark"
      ],
      "viewIDs": [
        "dashboard.home",
        "settings",
        "diagnostics",
        "about",
        "computer-search",
        "mobile-device-search",
        "support-technician",
        "prestage-director",
        "reports",
        "deployment-tracker",
        "permissions-matrix"
      ],
      "slotIDs": [
        "main",
        "toolbar",
        "diagnostics-drawer",
        "settings-sheet"
      ],
      "toolbarItemIDs": [
        "settings",
        "diagnostics",
        "refresh",
        "export"
      ],
      "routeIDs": [
        "home",
        "computer-search",
        "mobile-device-search",
        "support-technician",
        "prestage-director",
        "reports",
        "deployment-tracker",
        "permissions-matrix"
      ],
      "pointerIDs": []
    },
    "dataIsolation": {
      "mode": "private_to_module",
      "ownedStoreIDs": [
        "forsetti-retail-ui"
      ],
      "requiredDefaultRoles": []
    }
  }
}
