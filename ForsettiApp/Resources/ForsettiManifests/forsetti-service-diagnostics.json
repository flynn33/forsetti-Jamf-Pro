{
  "schemaVersion": "1.1",
  "manifestTemplateVersion": "1.1",
  "moduleID": "com.forsetti.jamfpro.service.diagnostics",
  "displayName": "Diagnostics Service",
  "moduleVersion": {
    "major": 1,
    "minor": 0,
    "patch": 0,
    "prerelease": null
  },
  "moduleType": "service",
  "supportedPlatforms": [
    "iOS",
    "macOS"
  ],
  "minForsettiVersion": {
    "major": 0,
    "minor": 1,
    "patch": 4,
    "prerelease": null
  },
  "maxForsettiVersion": null,
  "capabilitiesRequested": [
    "diagnostics",
    "telemetry",
    "file_export",
    "storage"
  ],
  "iapProductID": null,
  "entryPoint": "ForsettiDiagnosticsServiceModule",
  "defaultModuleRole": "diagnostics",
  "runtimeRequirements": {
    "io": [
      {
        "requirementID": "diagnostics-events",
        "kind": "diagnostics",
        "access": "consume",
        "required": true,
        "description": "Collect runtime and feature diagnostics."
      },
      {
        "requirementID": "diagnostics-telemetry",
        "kind": "telemetry",
        "access": "emit",
        "required": false,
        "description": "Optional diagnostic telemetry."
      },
      {
        "requirementID": "diagnostics-export",
        "kind": "file_export",
        "access": "write",
        "required": true,
        "description": "User-initiated diagnostic export."
      },
      {
        "requirementID": "diagnostics-storage",
        "kind": "storage",
        "access": "read_write",
        "required": true,
        "description": "Pruned local diagnostic log storage."
      }
    ],
    "ui": null,
    "dataIsolation": {
      "mode": "private_to_module",
      "ownedStoreIDs": [
        "forsetti-diagnostics-service"
      ],
      "requiredDefaultRoles": [
        "diagnostics"
      ]
    }
  }
}
