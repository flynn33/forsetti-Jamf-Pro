#!/usr/bin/env bash
set -euo pipefail

if [[ "${SKIP_VERSION_BUMP:-0}" == "1" ]]; then
  exit 0
fi

subject="$(git log -1 --format="%s")"
case "$subject" in
  chore:\ bump\ version*|*" [skip ci]"*) exit 0 ;;
esac

repo_root="$(git rev-parse --show-toplevel)"
version_file="$repo_root/VERSION"
project_file="$repo_root/Forsetti.xcodeproj/project.pbxproj"

if [[ ! -f "$version_file" ]]; then
  exit 0
fi

current="$(tr -d '[:space:]' < "$version_file")"
IFS='.' read -r major minor patch <<< "$current"
next="${major}.${minor}.$((patch + 1))"

printf '%s\n' "$next" > "$version_file"
if [[ -f "$project_file" ]]; then
  sed -i '' "s/MARKETING_VERSION = [^;]*/MARKETING_VERSION = ${next}/g" "$project_file"
  sed -i '' "s/CURRENT_PROJECT_VERSION = [^;]*/CURRENT_PROJECT_VERSION = ${next}/g" "$project_file"
fi

git add "$version_file" "$project_file"
git commit -m "chore: bump version to ${next} [skip ci]"
