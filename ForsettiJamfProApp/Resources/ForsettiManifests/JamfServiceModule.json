{
  "schemaVersion": "1.1",
  "manifestTemplateVersion": "1.1",
  "moduleID": "com.forsetti.jamfpro.service.jamf",
  "displayName": "Jamf Service",
  "moduleVersion": {
    "major": 1,
    "minor": 0,
    "patch": 0,
    "prerelease": "A1"
  },
  "moduleType": "service",
  "supportedPlatforms": [
    "iOS",
    "macOS"
  ],
  "minForsettiVersion": {
    "major": 0,
    "minor": 1,
    "patch": 0,
    "prerelease": null
  },
  "maxForsettiVersion": null,
  "capabilitiesRequested": [
    "networking",
    "secure_storage",
    "authentication",
    "api",
    "security",
    "diagnostics"
  ],
  "iapProductID": null,
  "entryPoint": "JamfServiceModule",
  "defaultModuleRole": "api",
  "runtimeRequirements": {
    "io": [
      {
        "requirementID": "jamf-service.networking",
        "kind": "networking",
        "access": "read_write",
        "required": true
      },
      {
        "requirementID": "jamf-service.secure-storage",
        "kind": "secure_storage",
        "access": "read_write",
        "required": true
      },
      {
        "requirementID": "jamf-service.authentication",
        "kind": "authentication",
        "access": "consume",
        "required": true
      },
      {
        "requirementID": "jamf-service.api",
        "kind": "api",
        "access": "consume",
        "required": true
      },
      {
        "requirementID": "jamf-service.security",
        "kind": "security",
        "access": "consume",
        "required": true
      },
      {
        "requirementID": "jamf-service.diagnostics",
        "kind": "diagnostics",
        "access": "emit",
        "required": false
      }
    ],
    "ui": null,
    "dataIsolation": {
      "mode": "private_to_module",
      "ownedStoreIDs": [
        "jamf-service"
      ],
      "requiredDefaultRoles": []
    }
  },
  "appVersion": "A1.0.0"
}
